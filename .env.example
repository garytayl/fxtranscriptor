## API.Bible (server-only)
API_BIBLE_KEY=
API_BIBLE_BASE_URL=https://api.scripture.api.bible/v1

## Two translations only: BSB + WEBU. Both IDs must be from YOUR key's allowed list.
## 403 "not authorized to access that bible" = that ID isn't on your plan. Get valid IDs:
##   curl -s -H "api-key: YOUR_KEY" "https://api.scripture.api.bible/v1/bibles" | jq '.data[] | {id, name, abbreviation}'
## Then set the "id" for Berean Standard Bible and World English Bible (Updated).
API_BIBLE_BSB_ID=
API_BIBLE_WEBU_ID=
## Default translation when switching: bsb or webu
API_BIBLE_DEFAULT_TRANSLATION=bsb

## Supabase (client-safe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

## Content sources (optional)
PODBEAN_RSS_URL=
YOUTUBE_CHANNEL_ID=
