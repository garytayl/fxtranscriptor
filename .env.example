## API.Bible (server-only)
API_BIBLE_KEY=
API_BIBLE_BASE_URL=https://api.scripture.api.bible/v1

## Two translations only: BSB + WEBU (set API_BIBLE_BSB_ID to enable)
## Get BSB id from: GET https://api.scripture.api.bible/v1/bibles (search for "Berean Standard Bible")
## WEBU id has a default; override if needed.
API_BIBLE_BSB_ID=bba9f40183526463-01
API_BIBLE_WEBU_ID=9879dbb7cfe39e4d-01
## Default translation when switching: bsb or webu
API_BIBLE_DEFAULT_TRANSLATION=bsb

## Supabase (client-safe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

## Content sources (optional)
PODBEAN_RSS_URL=
YOUTUBE_CHANNEL_ID=
