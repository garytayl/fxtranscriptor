## API.Bible (server-only)
API_BIBLE_KEY=
API_BIBLE_BASE_URL=https://api.scripture.api.bible/v1

API_BIBLE_TRANSLATIONS_JSON=[{"key":"webu","label":"World English Bible Updated","bibleId":"72f4e6dc683324df-01"},{"key":"web","label":"World English Bible","bibleId":"9879dbb7cfe39e4d-01"}] API_BIBLE_DEFAULT_TRANSLATION=webu

# King James Version is merged into the reader list automatically (API.Bible id de4e12af7f28f599-01) unless you already define key kjv or that bibleId in API_BIBLE_TRANSLATIONS_JSON.
# API_BIBLE_INCLUDE_KJV=0
# API_BIBLE_KJV_ID=

# Kaiserlik Strong's: server logs each chapter load as [strongs]… (local terminal or Vercel function logs).

## Two translations: either (A) BSB + WEBU, or (B) custom list.
## (A) BSB + WEBU — only if both appear in GET /api/bible/bibles for your key:
# API_BIBLE_BSB_ID=
# API_BIBLE_WEBU_ID=
## (B) If BSB isn't on your plan, use two bibles from your list (get IDs from /api/bible/bibles):
## Example: WEBU + World English Bible (no "Updated")
# API_BIBLE_TRANSLATIONS_JSON=[{"key":"webu","label":"World English Bible Updated","bibleId":"72f4e6dc683324df-01"},{"key":"web","label":"World English Bible","bibleId":"9879dbb7cfe39e4d-01"}]
## Default translation key (e.g. webu or web when using B)
# API_BIBLE_DEFAULT_TRANSLATION=webu

## Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
## Required for Generate transcription and other admin actions (server-only; keep secret)
SUPABASE_SERVICE_ROLE_KEY=

## Content sources (optional)
PODBEAN_RSS_URL=
YOUTUBE_CHANNEL_ID=

## PWA push notifications (optional; uses Railway worker)
## Public key only – set in Vercel. Same key pair as on Railway (VAPID_PUBLIC_KEY + VAPID_PRIVATE_KEY).
VAPID_PUBLIC_KEY=
## Railway worker URL (also used for audio chunking). Push subscribe is forwarded to worker /push/subscribe.
# AUDIO_WORKER_URL=https://your-worker.railway.app
